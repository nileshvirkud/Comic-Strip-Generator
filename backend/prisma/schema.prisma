// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  subscriptionTier String   @default("free") @map("subscription_tier")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  comics Comics[]

  @@map("users")
}

model Comics {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  title      String
  prompt     String
  status     ComicStatus       @default(GENERATING)
  templateId String            @map("template_id")
  metadata   Json
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  // Relations
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template           @relation(fields: [templateId], references: [id])
  panels   Panel[]
  jobs     GenerationJob[]

  @@map("comics")
}

model Panel {
  id                String   @id @default(cuid())
  comicId           String   @map("comic_id")
  panelNumber       Int      @map("panel_number")
  imageUrl          String?  @map("image_url")
  dialog            String   @default("")
  position          Json
  characters        String[]
  sceneDescription  String   @map("scene_description")
  midjourneyPrompt  String?  @map("midjourney_prompt")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  comic Comics @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([comicId, panelNumber])
  @@map("panels")
}

model Template {
  id           String   @id @default(cuid())
  name         String   @unique
  layoutConfig Json     @map("layout_config")
  thumbnailUrl String   @map("thumbnail_url")
  panelCount   Int      @map("panel_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  comics Comics[]

  @@map("templates")
}

model GenerationJob {
  id        String    @id @default(cuid())
  comicId   String    @map("comic_id")
  jobType   JobType   @map("job_type")
  status    JobStatus @default(PENDING)
  aiService String    @map("ai_service")
  progress  Int       @default(0)
  result    Json?
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  comic Comics @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@map("generation_jobs")
}

enum ComicStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum JobType {
  SCRIPT
  IMAGE
  ASSEMBLY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}