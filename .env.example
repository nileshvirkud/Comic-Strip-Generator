# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comic_strip_generator
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

MIDJOURNEY_API_KEY=your-midjourney-api-key
MIDJOURNEY_BASE_URL=https://api.midjourney.com

RUNWAYML_API_KEY=your-runwayml-api-key
RUNWAYML_BASE_URL=https://api.runwayml.com

# AWS/S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket

# Application
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Upload Settings
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend (for React app)
REACT_APP_API_URL=http://localhost:3001/api